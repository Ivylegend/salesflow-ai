# Core
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://salesflow:change-me@postgres:5432/salesflow

# Authentication (generate with: openssl rand -hex 32)
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ACCESS_TOKEN_MINUTES=480
SEED_DEMO_DATA=true

# OpenAI (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# n8n service authentication
N8N_BASE_URL=http://n8n:5678
N8N_LEAD_WEBHOOK_URL=http://n8n:5678/webhook/salesflow-lead
N8N_WEBHOOK_SECRET=
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=SalesFlow AI <hello@icha.ng>

# Cal.com
CALCOM_BOOKING_URL=
CALCOM_WEBHOOK_SECRET=

# PostgreSQL
POSTGRES_DB=salesflow
POSTGRES_USER=salesflow
POSTGRES_PASSWORD=
